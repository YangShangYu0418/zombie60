                    "Trust": 1
                  },
                  "xiaJian": {
                    "Trust": -1
                  }
                }
              }
            }
          }
        }
      ]
    },
    {
      "id": "CORE_HORDE",
      "pool": "queued",
      "title": "屍潮來襲",
      "once": false,
      "text": "先是狗叫，然後是玻璃碎裂的聲音，從巷口一路往這裡推進。\n你從鐵門的縫隙往外看——不是一隻、兩隻。是一整片會走路的影子，肩膀擠著肩膀，像漲潮。\n\n夏見已經握緊了斧頭。黎霜在算時間。宋寧把燈一盞一盞地關掉，回頭看你：『怎麼做？』",
      "choices": [
        {
          "label": "死守鐵門（彈藥 −2，最強戰力 COM 檢定）",
          "requires": {
            "resources": {
              "Ammo": {
                "gte": 2
              }
            }
          },
          "cost": {
            "Ammo": 2
          },
          "check": {
            "who": "best",
            "stat": "COM",
            "dc": 8
          },
          "outcomes": {
            "success": {
              "text": "槍聲、斧頭、嘶吼。不知道過了多久，撞擊聲變稀了，最後只剩下雨一樣的喘息。\n你們守住了。鐵門凹了一大塊，但還站著。",
              "effects": {
                "resources": {
                  "Defense": -4,
                  "Morale": 6,
                  "Noise": 4
                },
                "status": {
                  "Stress": 6
                }
              }
            },
            "fail": {
              "text": "鐵門的鉸鍊先撐不住。你們在樓梯口用身體和桌子堵出第二道牆，一直撐到天亮。\n活下來了。但每個人身上都多了一些不想看的傷。",
              "effects": {
                "resources": {
                  "Defense": -12,
                  "Morale": -6,
                  "Noise": 6
                },
                "status": {
                  "Health": -10,
                  "Stress": 12,
                  "Infection": 6
                }
              }
            }
          }
        },
        {
          "label": "熄燈、屏息，等它們過去（最理性者 LOG 檢定）",
          "check": {
            "who": "best",
            "stat": "LOG",
            "dc": 7
          },
          "outcomes": {
            "success": {
              "text": "四個人擠在最裡面的角落，連呼吸都數著節拍。\n外面的腳步聲經過、停下、又經過。天亮的時候，巷子空了。",
              "effects": {
