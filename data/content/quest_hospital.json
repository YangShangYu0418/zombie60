{
  "quests": [
    {
      "id": "q_hospital",
      "title": "萬芳的燈",
      "summary": "萬芳醫院的頂樓每晚十點亮一盞燈。燈下的女人在做藥，黑雨也想要她。",
      "stages": [
        {
          "flag": "qh_s1",
          "text": "萬芳醫院的最高樓層，每晚十點亮起一盞燈。"
        },
        {
          "flag": "qh_s2",
          "text": "你見到了林以安醫師，她獨自守著一座小實驗室。"
        },
        {
          "flag": "qh_s3",
          "text": "林醫師需要感染樣本與燃料。黑雨也在找她。"
        },
        {
          "flag": "qh_s4",
          "text": "你必須決定：保護她、交給黑雨，還是說服雙方合作。"
        },
        {
          "flag": "qh_done",
          "text": "第二十天，萬芳的燈有了結果。"
        }
      ]
    }
  ],
  "events": [
    {
      "id": "QH_001",
      "pool": "story",
      "title": "最高樓層的燈",
      "once": true,
      "conditions": {
        "anyChar": {
          "Infection": {
            "gte": 25
          }
        },
        "notFlags": [
          "qh_s1"
        ]
      },
      "text": "{target}的燒退不下來，半夜一直喊冷。\n你替對方換毛巾時，聽見窗外有人低聲說：『又亮了。』\n從窗縫望出去，萬芳醫院的最高樓層，有一盞燈在夜色裡亮起，又熄掉。\n旁邊的人跟著抬頭，沒人說話。封城以後，已經沒有人會替病房點燈了。",
      "choices": [
        {
          "label": "盯著那盞燈看到天亮（全隊 Stress +3）",
          "outcomes": {
            "always": {
              "text": "你把方位記在紙上，眼睛乾得像砂紙。天亮前，燈滅了，之後沒有再亮。",
              "effects": {
                "status": {
                  "Stress": 3
                },
                "flagsSet": [
                  "qh_s1"
                ],
                "discover": [
                  "wanfang_hospital"
                ]
              }
            }
          }
        },
        {
          "label": "叫黎霜用算的：這盞燈的電從哪來（LOG 檢定 dc 5）",
          "check": {
            "who": "best",
            "stat": "LOG",
            "dc": 5
          },
          "outcomes": {
            "success": {
              "text": "黎霜盯著線路圖算了二十分鐘，冷笑一聲：『醫院有自己的柴油機。他們的油，比我們多。』",
              "effects": {
                "resources": {
                  "Parts": 1
                },
                "flagsSet": [
                  "qh_s1"
                ],
                "discover": [
                  "wanfang_hospital"
                ]
              }
            },
            "fail": {
              "text": "她算到一半就把筆摔了：『線太亂，只能猜。』你們在屋頂翻找時碰倒一片鐵皮，整條巷子都聽見了。",
              "effects": {
                "resources": {
                  "Noise": 3
                },
                "flagsSet": [
                  "qh_s1"
                ],
                "discover": [
                  "wanfang_hospital"
                ]
              }
            }
          }
        },
        {
          "label": "把方位記在地圖背面，先不跟任何人說（Morale -2）",
          "outcomes": {
            "always": {
              "text": "你把地圖翻到背面，寫下醫院的名字，折成小小一塊，塞進口袋。有些事，現在還不適合讓大家知道。",
              "effects": {
                "resources": {
                  "Morale": -2
                },
                "flagsSet": [
                  "qh_s1"
                ],
                "discover": [
                  "wanfang_hospital"
                ]
              }
            }
          }
        }
      ]
