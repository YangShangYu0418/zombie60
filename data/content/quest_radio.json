{
  "quests": [
    {
      "id": "q_radio",
      "title": "另一端的聲音",
      "summary": "收音機裡有一個不是喪屍的頻率，有人在另一端等你們回話。",
      "stages": [
        {
          "flag": "qr_s1",
          "text": "收音機裡有規律的雜訊，像有人在另一端數拍子。"
        },
        {
          "flag": "qr_s2",
          "text": "黎霜解出雜訊的頻率與座標，指向國道三號的方向。"
        },
        {
          "flag": "qr_s3",
          "text": "在國道三號檢查哨找到士官長鄭岳，撤離點的聯絡人就是他。"
        },
        {
          "flag": "qr_s4",
          "text": "鄭岳要你們修好大型發報機，需要 Parts ×3、Med ×2，或去別處找零件。"
        },
        {
          "flag": "qr_s5",
          "text": "撤離點確定：第二十五天黃昏，國道三號交流道，直升機只停十二分鐘。"
        },
        {
          "flag": "qr_done",
          "text": "你做出了選擇。撤離，或留下。"
        }
      ]
    }
  ],
  "events": [
    {
      "id": "QR_001",
      "pool": "story",
      "title": "規律的雜訊",
      "once": true,
      "conditions": {
        "minDay": 3,
        "flags": [
          "hasRadio"
        ]
      },
      "text": "收音機在凌晨兩點突然出聲。\n不是電台，也不是喪屍那種嘶啞的喘息。是一種很規律的『滴、滴、滴——停』，像有人在另一端用指節敲桌面。\n黎霜從床上坐起來，咬住筆，把耳朵貼上喇叭。\n『這不是故障。』她說，『故障不會數拍子。』",
      "choices": [
        {
          "label": "調頻錄音，把整段雜訊存下來（Noise +3，動靜會傳出去）",
          "outcomes": {
            "always": {
              "text": "你把整段雜訊錄進舊的磁帶機，紅燈亮著，像一隻不肯閉上的眼睛。\n黎霜把錄音的副本抄在牆角，一個字都沒漏。",
              "effects": {
                "resources": {
                  "Noise": 3
                },
                "flagsSet": [
                  "qr_s1"
                ]
              }
            }
          }
        },
        {
          "label": "叫醒黎霜和宋寧，一起守著收音機（睡眠不足，全員 Stress +2）",
          "outcomes": {
            "always": {
              "text": "宋寧披著外套下樓，給每個人倒一杯溫水，才肯坐下來聽。\n黎霜沒有抬頭，只說：『第三個停頓比前兩個長。』\n宋寧笑了笑，手指在桌上跟著敲：『好，我記住了。』",
              "effects": {
                "status": {
                  "Stress": 2
                },
                "relations": {
                  "liShuang": {
                    "Trust": 2
                  },
                  "songNing": {
                    "Affection": 2
                  }
                },
                "flagsSet": [
                  "qr_s1"
                ]
              }
            }
          }
        },
        {
          "label": "關掉收音機，當作什麼都沒聽見（那節奏會在腦子裡響一整夜，全員 Stress +5）",
          "outcomes": {
            "always": {
              "text": "你把旋鈕轉回靜音。\n可是當夜，你在夢裡數了一整晚的停頓，一直數到天亮。\n早上黎霜看著你的黑眼圈，什麼都沒說，只把一杯熱茶放在你手邊。",
              "effects": {
                "status": {
                  "Stress": 5
                },
                "flagsSet": [
                  "qr_s1"
                ]
              }
            }
          }
        }
      ]
    },
    {
      "id": "QR_002",
      "pool": "story",
      "title": "黎霜的算式",
      "once": true,
      "conditions": {
        "minDay": 5,
        "flags": [
          "qr_s1"
